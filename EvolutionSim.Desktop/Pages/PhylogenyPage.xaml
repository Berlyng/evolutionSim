<Page x:Class="EvolutionSim.Desktop.Pages.PhylogenyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:EvolutionSim.Desktop"
      Background="{StaticResource BgBrush}"
      Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0"
                                 Columns="4"
                                 Margin="0,0,0,14">
                <Border Style="{StaticResource KpiCard}"
                                Background="{StaticResource CardBlueBrush}"
                                BorderBrush="{StaticResource InfoBrush}"
                                Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="RAMAS"
                                           Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="PhylogenyBranchCountText"
                                           Text="0"
                                           Foreground="{StaticResource InfoBrush}"
                                           Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCard}"
                                Background="{StaticResource CardGreenBrush}"
                                BorderBrush="{StaticResource SuccessBrush}"
                                Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="RAMAS ACTIVAS"
                                           Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="PhylogenyActiveBranchCountText"
                                           Text="0"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCard}"
                                Background="{StaticResource CardPurpleBrush}"
                                BorderBrush="{StaticResource PurpleBrush}"
                                Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="RAÍCES"
                                           Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="PhylogenyRootCountText"
                                           Text="0"
                                           Foreground="{StaticResource PurpleBrush}"
                                           Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCard}"
                                Background="{StaticResource CardOrangeBrush}"
                                BorderBrush="{StaticResource WarnBrush}"
                                Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="PROFUNDIDAD MÁX."
                                           Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="PhylogenyDepthText"
                                           Text="0"
                                           Foreground="{StaticResource WarnBrush}"
                                           Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0"
                                  Header="ÁRBOL FILOGENÉTICO TEMPORAL"
                                  Margin="0,0,10,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          Background="#11151B">
                        <local:PhylogenyTreeControl x:Name="PhylogenyTreeView"
                                                            MinWidth="760"
                                                            MinHeight="300" />
                    </ScrollViewer>
                </GroupBox>

                <GroupBox Grid.Column="1"
                                  Header="RAMAS"
                                  Margin="10,0,0,0">
                    <DataGrid ItemsSource="{Binding PhylogenyRows}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                        Binding="{Binding SpeciesLabel}"
                                                        Width="48" />
                            <DataGridTextColumn Header="Padre"
                                                        Binding="{Binding ParentLabel}"
                                                        Width="58" />
                            <DataGridTextColumn Header="Prof."
                                                        Binding="{Binding Depth}"
                                                        Width="50" />
                            <DataGridTextColumn Header="Confirm."
                                                        Binding="{Binding ConfirmedCycle}"
                                                        Width="68" />
                            <DataGridTextColumn Header="Fin"
                                                        Binding="{Binding EndCycleText}"
                                                        Width="58" />
                            <DataGridTextColumn Header="Estado"
                                                        Binding="{Binding StatusText}"
                                                        Width="92" />
                            <DataGridTextColumn Header="Hijos"
                                                        Binding="{Binding DirectDescendantCount}"
                                                        Width="50" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>

</Page>
