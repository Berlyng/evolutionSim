<Page x:Class="EvolutionSim.Desktop.Pages.PatchesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:EvolutionSim.Desktop"
      Background="{StaticResource BgBrush}"
      Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,14,0,0">
            <ItemsControl ItemsSource="{Binding PatchRegionRows}"
                                  Margin="4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <GroupBox Margin="0,0,0,18">
                            <GroupBox.Header>
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8"
                                                        Height="8"
                                                        CornerRadius="4"
                                                        Background="{StaticResource AccentBrush}"
                                                        Margin="0,4,8,0"
                                                        VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding Name}"
                                                           FontWeight="Bold"
                                                           FontSize="14" />
                                    </StackPanel>

                                    <Border DockPanel.Dock="Right"
                                                    Background="{StaticResource SurfaceBrush}"
                                                    CornerRadius="6"
                                                    Padding="8,3"
                                                    Margin="14,0,0,0">
                                        <TextBlock Text="{Binding RegionTemperatureText}"
                                                           Foreground="{StaticResource WarnBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12" />
                                    </Border>
                                </DockPanel>
                            </GroupBox.Header>

                            <ItemsControl ItemsSource="{Binding Patches}"
                                                  Margin="6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RegionCard}"
                                                        Margin="6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0"
                                                                   Margin="0,0,0,14">
                                                    <StackPanel DockPanel.Dock="Left">
                                                        <TextBlock Text="{Binding Name}"
                                                                           FontSize="17"
                                                                           FontWeight="Bold" />
                                                        <TextBlock Text="{Binding PatchId, StringFormat=PATCH {0}}"
                                                                           Style="{StaticResource SectionLabel}"
                                                                           Margin="0,3,0,0" />
                                                    </StackPanel>

                                                    <Border DockPanel.Dock="Right"
                                                                    Background="{StaticResource SurfaceAltBrush}"
                                                                    CornerRadius="6"
                                                                    Padding="8,4"
                                                                    HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding LocalTemperatureText}"
                                                                           Foreground="{StaticResource WarnBrush}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12" />
                                                    </Border>
                                                </DockPanel>

                                                <Grid Grid.Row="1"
                                                              Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="POBLACIÓN"
                                                                           Style="{StaticResource SectionLabel}" />
                                                        <TextBlock Text="{Binding PopulationText}"
                                                                           FontSize="22"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="PLANTAS"
                                                                           Style="{StaticResource SectionLabel}" />
                                                        <TextBlock Text="{Binding PlantBiomassText}"
                                                                           Style="{StaticResource SectionValue}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="CARNE"
                                                                           Style="{StaticResource SectionLabel}" />
                                                        <TextBlock Text="{Binding CarcassBiomassText}"
                                                                           Style="{StaticResource SectionValue}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Border Grid.Row="2"
                                                                Background="{StaticResource SurfaceAltBrush}"
                                                                CornerRadius="8"
                                                                Padding="12,10"
                                                                Margin="0,0,0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="DENSIDAD ENERGÉTICA"
                                                                               Style="{StaticResource SectionLabel}" />
                                                            <TextBlock Text="{Binding PlantEnergyDensity, StringFormat={}{0:F2}}"
                                                                               FontWeight="SemiBold"
                                                                               Margin="0,2,0,0" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="DUREZA VEGETAL"
                                                                               Style="{StaticResource SectionLabel}" />
                                                            <TextBlock Text="{Binding PlantToughness, StringFormat={}{0:F2}}"
                                                                               FontWeight="SemiBold"
                                                                               Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Row="3"
                                                                    Margin="0,0,0,12">
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock Text="PARTICIPACIÓN REGIONAL"
                                                                           Style="{StaticResource SectionLabel}" />
                                                        <TextBlock Text="{Binding RegionalPopulationShareText}"
                                                                           DockPanel.Dock="Right"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </DockPanel>

                                                    <ProgressBar Height="8"
                                                                         Minimum="0"
                                                                         Maximum="100"
                                                                         Value="{Binding RegionalPopulationSharePercent}" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="4"
                                                                   Text="{Binding ResourceSummary}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="12"
                                                                   LineHeight="17" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</Page>
