<Page x:Class="EvolutionSim.Desktop.Pages.MovementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:EvolutionSim.Desktop"
      Background="{StaticResource BgBrush}"
      Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,14,0,0">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0"
                                     Columns="2"
                                     Margin="0,0,0,16">
                    <Border Style="{StaticResource KpiCard}"
                                    Margin="0,0,8,0"
                                    Background="{StaticResource CardGreenBrush}"
                                    BorderBrush="{StaticResource SuccessBrush}">
                        <StackPanel>
                            <TextBlock Text="MIGRACIONES DEL CICLO"
                                               Style="{StaticResource KpiLabel}" />
                            <TextBlock x:Name="MovementMigrationsText"
                                               Text="0"
                                               Foreground="{StaticResource AccentBrush}"
                                               Style="{StaticResource KpiValue}" />
                            <TextBlock Text="Cruces exitosos entre regiones"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource KpiCard}"
                                    Margin="8,0,0,0"
                                    Background="{StaticResource CardOrangeBrush}"
                                    BorderBrush="{StaticResource WarnBrush}">
                        <StackPanel>
                            <TextBlock Text="MOVIMIENTOS LOCALES"
                                               Style="{StaticResource KpiLabel}" />
                            <TextBlock x:Name="MovementLocalText"
                                               Text="0"
                                               Foreground="{StaticResource WarnBrush}"
                                               Style="{StaticResource KpiValue}" />
                            <TextBlock Text="Cruces exitosos entre patches"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="1"
                              Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="FLUJO REAL · MIGRACIÓN ENTRE REGIONES"
                                      Margin="0,0,8,0">
                        <DataGrid ItemsSource="{Binding MigrationRouteRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          MinHeight="170"
                                          Margin="4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Origen"
                                                            Binding="{Binding OriginName}"
                                                            Width="*" />
                                <DataGridTextColumn Header="Destino"
                                                            Binding="{Binding DestinationName}"
                                                            Width="*" />
                                <DataGridTextColumn Header="Cantidad"
                                                            Binding="{Binding Count}"
                                                            Width="75" />
                                <DataGridTextColumn Header="Fit térmica"
                                                            Binding="{Binding AverageThermalFitness, StringFormat=F3}"
                                                            Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Column="1"
                                      Header="FLUJO REAL · MOVIMIENTO ENTRE PATCHES"
                                      Margin="8,0,0,0">
                        <DataGrid ItemsSource="{Binding LocalMovementRouteRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          MinHeight="170"
                                          Margin="4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Origen"
                                                            Binding="{Binding OriginName}"
                                                            Width="*" />
                                <DataGridTextColumn Header="Destino"
                                                            Binding="{Binding DestinationName}"
                                                            Width="*" />
                                <DataGridTextColumn Header="Cantidad"
                                                            Binding="{Binding Count}"
                                                            Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="TOPOLOGÍA · CONEXIONES REGIONALES"
                                      Margin="0,0,8,0">
                        <DataGrid ItemsSource="{Binding RegionConnectionRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          MinHeight="180"
                                          Margin="4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Conexión"
                                                            Binding="{Binding ConnectionText}"
                                                            Width="*" />
                                <DataGridTextColumn Header="Dificultad"
                                                            Binding="{Binding Difficulty, StringFormat=F2}"
                                                            Width="85" />
                                <DataGridTextColumn Header="Costo"
                                                            Binding="{Binding EnergyCost, StringFormat=F2}"
                                                            Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Column="1"
                                      Header="TOPOLOGÍA · CONEXIONES ENTRE PATCHES"
                                      Margin="8,0,0,0">
                        <DataGrid ItemsSource="{Binding PatchConnectionRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          MinHeight="180"
                                          Margin="4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Conexión"
                                                            Binding="{Binding ConnectionText}"
                                                            Width="*" />
                                <DataGridTextColumn Header="Dificultad"
                                                            Binding="{Binding Difficulty, StringFormat=F2}"
                                                            Width="85" />
                                <DataGridTextColumn Header="Costo"
                                                            Binding="{Binding EnergyCost, StringFormat=F2}"
                                                            Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>

</Page>
