<Page x:Class="EvolutionSim.Desktop.Pages.SpeciesHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:EvolutionSim.Desktop"
      Background="{StaticResource BgBrush}"
      Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0"
                                 Columns="4"
                                 Margin="0,0,0,14">
                <Border Style="{StaticResource KpiCard}"
                                Background="{StaticResource CardBlueBrush}"
                                BorderBrush="{StaticResource InfoBrush}"
                                Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="ESPECIES HISTÓRICAS"
                                           Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="HistoricalSpeciesCountText"
                                           Text="0"
                                           Foreground="{StaticResource InfoBrush}"
                                           Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCard}"
                                Background="{StaticResource CardGreenBrush}"
                                BorderBrush="{StaticResource SuccessBrush}"
                                Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="ACTIVAS"
                                           Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="ActiveSpeciesHistoryCountText"
                                           Text="0"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCard}"
                                Background="{StaticResource CardOrangeBrush}"
                                BorderBrush="{StaticResource WarnBrush}"
                                Margin="8,0">
                    <StackPanel>
                        <TextBlock Text="YA NO DETECTADAS"
                                           Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="InactiveSpeciesHistoryCountText"
                                           Text="0"
                                           Foreground="{StaticResource WarnBrush}"
                                           Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource KpiCard}"
                                Background="{StaticResource CardPurpleBrush}"
                                BorderBrush="{StaticResource PurpleBrush}"
                                Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="EVENTOS"
                                           Style="{StaticResource KpiLabel}" />
                        <TextBlock x:Name="SpeciesHistoryEventCountText"
                                           Text="0"
                                           Foreground="{StaticResource PurpleBrush}"
                                           Style="{StaticResource KpiValue}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="6*" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0"
                                  Header="LINAJES REGISTRADOS"
                                  Margin="0,0,10,0">
                    <DataGrid x:Name="SpeciesHistoryGrid"
                                      ItemsSource="{Binding SpeciesHistoryRows}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                        Binding="{Binding SpeciesLabel}"
                                                        Width="48" />
                            <DataGridTextColumn Header="Estado"
                                                        Binding="{Binding StatusText}"
                                                        Width="95" />
                            <DataGridTextColumn Header="Padre"
                                                        Binding="{Binding ParentLabel}"
                                                        Width="58" />
                            <DataGridTextColumn Header="1ª obs."
                                                        Binding="{Binding FirstObservedCycle}"
                                                        Width="68" />
                            <DataGridTextColumn Header="Confirm."
                                                        Binding="{Binding ConfirmedCycle}"
                                                        Width="68" />
                            <DataGridTextColumn Header="Última"
                                                        Binding="{Binding LastConfirmedCycle}"
                                                        Width="65" />
                            <DataGridTextColumn Header="Pop"
                                                        Binding="{Binding LatestPopulation}"
                                                        Width="65" />
                            <DataGridTextColumn Header="Pico"
                                                        Binding="{Binding PeakPopulation}"
                                                        Width="65" />
                            <DataGridTextColumn Header="Det."
                                                        Binding="{Binding DetectionCount}"
                                                        Width="48" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <Grid Grid.Column="1"
                              Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0"
                                      Header="EVOLUCIÓN DEL LINAJE"
                                      Margin="0,0,0,8">
                        <DataGrid ItemsSource="{Binding SpeciesHistoryObservationRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          Margin="4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ciclo"
                                                            Binding="{Binding Cycle}"
                                                            Width="62" />
                                <DataGridTextColumn Header="Pop"
                                                            Binding="{Binding Population}"
                                                            Width="65" />
                                <DataGridTextColumn Header="Dist"
                                                            Binding="{Binding AverageDistanceToCentroid, StringFormat=F3}"
                                                            Width="65" />
                                <DataGridTextColumn Header="OptTemp"
                                                            Binding="{Binding OptimalTemperature, StringFormat=F2}"
                                                            Width="72" />
                                <DataGridTextColumn Header="Tol"
                                                            Binding="{Binding ThermalTolerance, StringFormat=F2}"
                                                            Width="60" />
                                <DataGridTextColumn Header="Size"
                                                            Binding="{Binding Size, StringFormat=F2}"
                                                            Width="58" />
                                <DataGridTextColumn Header="Met"
                                                            Binding="{Binding Metabolism, StringFormat=F2}"
                                                            Width="58" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Row="1"
                                      Header="EVENTOS DEL LINAJE"
                                      Margin="0,8,0,0">
                        <DataGrid ItemsSource="{Binding SelectedSpeciesHistoryEventRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          Margin="4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ciclo"
                                                            Binding="{Binding Cycle}"
                                                            Width="62" />
                                <DataGridTextColumn Header="Tipo"
                                                            Binding="{Binding TypeText}"
                                                            Width="130" />
                                <DataGridTextColumn Header="Relacionado"
                                                            Binding="{Binding RelatedSpeciesLabel}"
                                                            Width="82" />
                                <DataGridTextColumn Header="Descripción"
                                                            Binding="{Binding Description}"
                                                            Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</Page>
