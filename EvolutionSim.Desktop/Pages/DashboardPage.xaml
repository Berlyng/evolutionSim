<Page x:Class="EvolutionSim.Desktop.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:EvolutionSim.Desktop"
      Background="{StaticResource BgBrush}"
      Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0"
                     Columns="6"
                     Margin="0,0,0,16">
            <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0" Background="{StaticResource CardBlueBrush}" BorderBrush="{StaticResource InfoBrush}">
                <StackPanel>
                    <TextBlock Text="CICLO" Style="{StaticResource KpiLabel}" />
                    <TextBlock x:Name="CycleText"
                               Text="0"
                               Foreground="{StaticResource InfoBrush}"
                               Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0" Background="{StaticResource CardGreenBrush}" BorderBrush="{StaticResource SuccessBrush}">
                <StackPanel>
                    <TextBlock Text="POBLACIÓN" Style="{StaticResource KpiLabel}" />
                    <TextBlock x:Name="PopulationText"
                               Text="0"
                               Foreground="{StaticResource AccentBrush}"
                               Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0" Background="{StaticResource CardCyanBrush}" BorderBrush="{StaticResource CyanBrush}">
                <StackPanel>
                    <TextBlock Text="NACIMIENTOS" Style="{StaticResource KpiLabel}" />
                    <TextBlock x:Name="BirthsText"
                               Text="0"
                               Foreground="{StaticResource CyanBrush}"
                               Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0" Background="{StaticResource CardRedBrush}" BorderBrush="{StaticResource DangerBrush}">
                <StackPanel>
                    <TextBlock Text="MUERTES" Style="{StaticResource KpiLabel}" />
                    <TextBlock x:Name="DeathsText"
                               Text="0"
                               Foreground="{StaticResource DangerBrush}"
                               Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0" Background="{StaticResource CardPurpleBrush}" BorderBrush="{StaticResource PurpleBrush}">
                <StackPanel>
                    <TextBlock Text="ESPECIES" Style="{StaticResource KpiLabel}" />
                    <TextBlock x:Name="SpeciesText"
                               Text="0"
                               Foreground="{StaticResource PurpleBrush}"
                               Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource KpiCard}" Background="{StaticResource CardOrangeBrush}" BorderBrush="{StaticResource WarnBrush}">
                <StackPanel>
                    <TextBlock Text="GENERACIÓN MEDIA" Style="{StaticResource KpiLabel}" />
                    <TextBlock x:Name="GenerationText"
                               Text="0.0"
                               Foreground="{StaticResource WarnBrush}"
                               Style="{StaticResource KpiValue}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <GroupBox Grid.Row="1"
                  Header="MUNDO · ESTADO REGIONAL"
                  Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding RegionVisualRows}"
                              Margin="6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RegionCard}" Margin="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0"
                                           Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Name}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               DockPanel.Dock="Left" />
                                        <Border DockPanel.Dock="Right"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            CornerRadius="6"
                                            Padding="8,3"
                                            HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding TemperatureText}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource WarnBrush}" />
                                        </Border>
                                    </DockPanel>

                                    <Grid Grid.Row="1"
                                      Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="POBLACIÓN" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding PopulationText}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="NAC / MUERT" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding BirthDeathText}"
                                                   Style="{StaticResource SectionValue}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="PLANTAS" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding PlantBiomassText}"
                                                   Style="{StaticResource SectionValue}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="2"
                                            Margin="0,0,0,12">
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="PARTICIPACIÓN POBLACIONAL"
                                                   Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding PopulationShareText}"
                                                   HorizontalAlignment="Right"
                                                   DockPanel.Dock="Right"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        </DockPanel>
                                        <ProgressBar Height="8"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding PopulationSharePercent}" />
                                    </StackPanel>

                                    <Border Grid.Row="3"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="OPTTEMP MEDIA" Style="{StaticResource SectionLabel}" />
                                                <TextBlock Text="{Binding OptimalTemperatureText}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="TOLERANCIA TÉRMICA" Style="{StaticResource SectionLabel}" />
                                                <TextBlock Text="{Binding ThermalToleranceText}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="4"
                                           Text="{Binding EcologySummary}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           LineHeight="17" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="DETALLE REGIONAL"
                              Margin="0,0,10,0">
                <DataGrid x:Name="RegionsGrid"
                                  ItemsSource="{Binding RegionRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Región"
                                                     Binding="{Binding Name}"
                                                     Width="*" />
                        <DataGridTextColumn Header="Temp"
                                                     Binding="{Binding Temperature, StringFormat={}{0:F1} °C}"
                                                     Width="75" />
                        <DataGridTextColumn Header="Pop"
                                                     Binding="{Binding Population}"
                                                     Width="70" />
                        <DataGridTextColumn Header="Nac"
                                                     Binding="{Binding Births}"
                                                     Width="60" />
                        <DataGridTextColumn Header="Muert"
                                                     Binding="{Binding Deaths}"
                                                     Width="60" />
                        <DataGridTextColumn Header="Plantas"
                                                     Binding="{Binding PlantBiomass, StringFormat=F0}"
                                                     Width="80" />
                        <DataGridTextColumn Header="OptTemp"
                                                     Binding="{Binding OptimalTemperature, StringFormat=F2}"
                                                     Width="80" />
                        <DataGridTextColumn Header="Tol"
                                                     Binding="{Binding ThermalTolerance, StringFormat=F2}"
                                                     Width="70" />
                        <DataGridTextColumn Header="Size"
                                                     Binding="{Binding Size, StringFormat=F2}"
                                                     Width="65" />
                        <DataGridTextColumn Header="Met"
                                                     Binding="{Binding Metabolism, StringFormat=F2}"
                                                     Width="65" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1"
                              Header="ESPECIES CONFIRMADAS"
                              Margin="10,0,0,0">
                <DataGrid x:Name="SpeciesGrid"
                                  ItemsSource="{Binding SpeciesRows}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                                     Binding="{Binding SpeciesLabel}"
                                                     Width="55" />
                        <DataGridTextColumn Header="Pop"
                                                     Binding="{Binding Population}"
                                                     Width="70" />
                        <DataGridTextColumn Header="Desde"
                                                     Binding="{Binding FirstDetectedCycle}"
                                                     Width="70" />
                        <DataGridTextColumn Header="OptTemp"
                                                     Binding="{Binding OptimalTemperature, StringFormat=F2}"
                                                     Width="80" />
                        <DataGridTextColumn Header="Tol"
                                                     Binding="{Binding ThermalTolerance, StringFormat=F2}"
                                                     Width="70" />
                        <DataGridTextColumn Header="Size"
                                                     Binding="{Binding Size, StringFormat=F2}"
                                                     Width="65" />
                        <DataGridTextColumn Header="Met"
                                                     Binding="{Binding Metabolism, StringFormat=F2}"
                                                     Width="65" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>

</Page>
